# ============================================================
# claw-quant-data 环境变量配置模板
# ============================================================
# 复制此文件为 .env 后填写真实值
#   cp .env.example .env
# ============================================================

# PostgreSQL 连接配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tushare_db
DB_USER=tushare
DB_PASSWORD=请设置强密码

# Tushare Pro Token（建议；未设置时会从 sys_config 表读取）
TUSHARE_TOKEN=你的tushare_token
TUSHARE_GLOBAL_MIN_INTERVAL_SECONDS=0.5
# Docker 路由不可达时快速失败；已连接的大页读取仍允许较长时间。
TUSHARE_CONNECT_TIMEOUT_SECONDS=5
TUSHARE_READ_TIMEOUT_SECONDS=60
# all=保存全部逐行原文；anomalies_only=成功数据只保留请求证据，异常时保留原文；none=不保存逐行原文。
TUSHARE_RAW_RECORD_CAPTURE_MODE=anomalies_only

# Financial Data Query（实时/基本面/宏观的按需查询源）。密钥只写入 .env，禁止提交。
FINANCIAL_DATA_API_KEY=
FINANCIAL_DATA_BASE_URL=https://dfdatamcpnexus-prod.antgroup-inc.cn/api/v1/common_query
FINANCIAL_DATA_API_VERSION=1.6.0
FINANCIAL_DATA_CONNECT_TIMEOUT_SECONDS=20
FINANCIAL_DATA_READ_TIMEOUT_SECONDS=300

# 数据服务
API_BIND_HOST=127.0.0.1
API_PORT=8000
APP_REVISION=0.1.0
API_DB_POOL_MIN=1
API_DB_POOL_MAX=10
API_DB_CONNECT_RETRIES=12
API_DB_CONNECT_RETRY_SECONDS=5
JOB_POLL_INTERVAL_SECONDS=2
JOB_STALE_AFTER_SECONDS=21600
JOB_EXECUTION_TIMEOUT_SECONDS=1800
JOB_LEASE_SECONDS=120
JOB_RECLAIM_INTERVAL_SECONDS=60
# DNS/网络故障使用分钟级指数退避，并暂停同资源池，避免批量耗尽重试。
JOB_NETWORK_RETRY_BASE_SECONDS=60
JOB_NETWORK_RETRY_MAX_SECONDS=900
# 历史补采/初始化在交易日白天静默；日常增量任务不受影响。
HISTORY_COLLECTION_PAUSE_START_TIME=08:30
HISTORY_COLLECTION_RESUME_TIME=16:00
# 仅对已证明可重试的初始化故障自动恢复；真数据/契约问题仍需人工处理。
INITIALIZATION_AUTO_RECOVERY_COOLDOWN_SECONDS=300
INITIALIZATION_AUTO_RECOVERY_MAX_ROUNDS=3
SCHEDULE_RECONCILE_LOOKBACK_DAYS=8
COVERAGE_POLL_INTERVAL_SECONDS=5
COVERAGE_STALE_AFTER_SECONDS=3600
COVERAGE_AUTO_REPAIR_ENABLED=true
COVERAGE_AUTO_REPAIR_LIMIT=10
SERVICE_HEARTBEAT_MAX_AGE_SECONDS=90

# 通知渠道（可选，默认只打日志）
# NOTIFIER_TYPE=dingtalk

# 钉钉通知配置（NOTIFIER_TYPE=dingtalk 时生效）
# DINGTALK_USER_ID=你的钉钉userId

# PostgreSQL 自动备份：默认每天一次，最多保留 14 天/3 份。
# raw 行级响应是可由上游重建的热缓存，默认只备份其表结构；请求证据和
# 规范化业务表仍包含在备份中，避免原始响应让每日备份无限膨胀。
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=3
BACKUP_EXCLUDE_TABLE_DATA=tushare_raw_record
BACKUP_COMPRESSION=zstd:1
# Safe horizontal history throughput. Distributed upstream rate limits and
# database scope locks remain authoritative when workers run concurrently.
V2_BACKFILL_WORKER_REPLICAS=3
V2_ROUTINE_WORKER_REPLICAS=3
